{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_USE_FIREBASE_EMULATOR": "true",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "demo-platform"
      }
    },
    "android-development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_FIREBASE_EMULATOR": "true",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "demo-platform"
      }
    },
    "android-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_FIREBASE_EMULATOR": "true",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "demo-platform"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "ios-simulator-standalone": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_USE_FIREBASE_EMULATOR": "true",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "demo-platform"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
